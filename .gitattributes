# Fine riga LF per tutti i file di testo, su qualunque sistema operativo.
# Gli script eseguiti nei container Linux (entrypoint .sh, Python) con CRLF non partono.
* text=auto eol=lf

# Script Windows: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binari: nessuna conversione né diff testuale
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.sqlite binary
*.db binary
*.parquet binary
